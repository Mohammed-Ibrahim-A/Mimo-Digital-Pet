// ===============================
// Helpers for the SAD / ANGRY faces
// ===============================
static void faceThickLine(int x0, int y0, int x1, int y1, int r, uint16_t c) {
  int dx = x1 - x0, dy = y1 - y0;
  int steps = max(abs(dx), abs(dy));
  if (steps == 0) steps = 1;
  for (int i = 0; i <= steps; i++) {
    display.fillCircle(x0 + dx * i / steps, y0 + dy * i / steps, r, c);
  }
}

static void faceFillEllipse(int cx, int cy, int rx, int ry, uint16_t c) {
  for (int dy = -ry; dy <= ry; dy++) {
    float k = 1.0f - ((float)dy * dy) / ((float)ry * ry);
    int w = (int)(rx * sqrtf(k < 0 ? 0 : k) + 0.5f);
    display.drawFastHLine(cx - w, cy + dy, 2 * w + 1, c);
  }
}

// Curved, tapered sad eyebrow (quadratic curve). The right brow is the
// mirror image of the left one (x -> 127 - x).
static void faceSadBrow(bool mirrored) {
  const float x0 = 28.5f, y0 = 22.0f;    // outer end (low)
  const float cx = 38.0f, cy = 22.0f;    // curve control point
  const float x2 = 45.0f, y2 = 14.5f;    // inner end (high)
  for (int i = 0; i <= 40; i++) {
    float t = i / 40.0f, u = 1.0f - t;
    float x = u * u * x0 + 2 * u * t * cx + t * t * x2;
    float y = u * u * y0 + 2 * u * t * cy + t * t * y2;
    int px = (int)(x + 0.5f), py = (int)(y + 0.5f);
    if (mirrored) px = 127 - px;
    display.fillCircle(px, py, 1, C_ON);
    if (t > 0.2f && t < 0.8f) display.fillCircle(px, py + 1, 1, C_ON);  // thicker middle
  }
}

