// ===============================
// CLOCK
// ===============================
// Vertical layout (ink rows, 64 px tall):
//   date     size 2 : y  1..14   "Fri 06 Nov" (10 chars = 119 px wide)
//   time     size 3 : y 20..40   "12:45" (87 px) + AM/PM size 2 beside it
//   seconds  size 2 : y 47..60   "SEC 05"
// Widest case: 87 + 6 gap + 22 = 115 px, centred, so everything stays inside 128x64.
void drawClock(bool force) {
  if (!displayReady) return;

  time_t nowT = time(nullptr);
  bool synced = (nowT >= 1700000000);

  // Repaint only when the shown second changes (or the status text changes).
  uint32_t sig = synced ? (uint32_t)nowT : (WiFi.status() == WL_CONNECTED ? 1u : 0u);
  static uint32_t lastSig = 0xFFFFFFFFu;
  if (!force && sig == lastSig) return;
  lastSig = sig;

  display.clearDisplay();
  display.setTextColor(C_ON);

  if (!synced) {
    if (WiFi.status() == WL_CONNECTED) drawTwoLines("Syncing", "time...");
    else                               drawTwoLines("Connect", "WiFi...");
    display.display();
    return;
  }

  struct tm t;
  localtime_r(&nowT, &t);

  char dateBuf[16], timeBuf[8], secBuf[10];
  strftime(dateBuf, sizeof(dateBuf), "%a %d %b", &t);       // e.g. "Fri 06 Nov"
  int h12 = t.tm_hour % 12;
  if (h12 == 0) h12 = 12;
  snprintf(timeBuf, sizeof(timeBuf), "%d:%02d", h12, t.tm_min);
  snprintf(secBuf, sizeof(secBuf), "SEC %02d", t.tm_sec);

  // Date
  drawCentered(dateBuf, 1, 2);

  // Time (size 3) with AM/PM (size 2) bottom-aligned beside it
  const int timeW  = (int)strlen(timeBuf) * 18 - 3;         // size-3 glyph pitch is 18 px
  const int ampmW  = 2 * 12 - 2;                            // "AM"/"PM" at size 2
  const int gap    = 6;
  int x0 = (SCREEN_W - (timeW + gap + ampmW)) / 2;
  if (x0 < 0) x0 = 0;
  display.setTextSize(3);
  display.setCursor(x0, 20);
  display.print(timeBuf);
  display.setTextSize(2);
  display.setCursor(x0 + timeW + gap, 26);
  display.print(t.tm_hour >= 12 ? "PM" : "AM");

  // Seconds
  drawCentered(secBuf, 47, 2);

  display.display();
}

// ===============================
// WEATHER
// ===============================
// Vertical layout (ink rows):
//   temperature  size 3 : y  2..22   "31.4" + degree ring + "C" (size 2)
//   humidity     size 2 : y 29..42   "Humid 72%"  (max 10 chars = 119 px)
//   condition    size 2 : y 48..61   e.g. "Partly cld" (max 10 chars)
//   SYNC / OLD   size 1 : top-right corner (x>=104, y 0..6), clear of the temperature
void drawWeather(uint32_t now, bool force) {
  if (!displayReady) return;

  WeatherData w;
  portENTER_CRITICAL(&weatherMux);
  w = weather;
  portEXIT_CRITICAL(&weatherMux);

  bool fetching = weatherFetching;
  bool failed   = weatherLastFailed;
  bool wifiOk   = (WiFi.status() == WL_CONNECTED);
  bool stale    = w.valid && (now - w.updatedAt) > WEATHER_STALE_MS;

  // Repaint only when something that is shown has changed.
  uint32_t sig = w.updatedAt * 31u
               + (fetching ? 1u : 0u) + (stale ? 2u : 0u) + (wifiOk ? 4u : 0u)
               + (failed ? 8u : 0u) + (w.valid ? 16u : 0u);
  static uint32_t lastSig = 0xFFFFFFFFu;
  if (!force && sig == lastSig) return;
  lastSig = sig;

  display.clearDisplay();
  display.setTextColor(C_ON);

  if (!w.valid) {
    if (!wifiOk)                    drawTwoLines("No WiFi", "Reconnect");
    else if (failed && !fetching)   drawTwoLines("Weather", "Error");
    else                            drawTwoLines("Loading", "weather..");
    display.display();
    return;
  }

  // Small status tag, top-right
  const char* status = "";
  if (fetching) status = "SYNC";
  else if (stale) status = "OLD";
  if (status[0] != '\0') {
    display.setTextSize(1);
    display.setCursor(SCREEN_W - ((int)strlen(status) * 6 - 1), 0);
    display.print(status);
  }

  // Temperature: big digits, degree ring, "C"
  char tempBuf[12];
  snprintf(tempBuf, sizeof(tempBuf), "%.1f", w.tempC);
  const int tempW  = (int)strlen(tempBuf) * 18 - 3;
  const int totalW = tempW + 11 + 10;                       // digits + degree gap + "C"
  int x0 = (SCREEN_W - totalW) / 2;
  if (x0 < 0) x0 = 0;
  display.setTextSize(3);
  display.setCursor(x0, 2);
  display.print(tempBuf);
  display.drawCircle(x0 + tempW + 6, 5, 2, C_ON);           // degree ring
  display.setTextSize(2);
  display.setCursor(x0 + tempW + 11, 9);
  display.print("C");

  // Humidity on its own line
  int hum = w.humidity;
  if (hum < 0) hum = 0;
  if (hum > 100) hum = 100;
  char humBuf[16];
  snprintf(humBuf, sizeof(humBuf), "Humid %d%%", hum);
  drawCentered(humBuf, 29, 2);

  // Condition on its own line
  drawCentered(weatherText(w.code), 48, 2);

  display.display();
}
