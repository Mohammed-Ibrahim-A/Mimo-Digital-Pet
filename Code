// =====================================================================
//                               SETUP
// =====================================================================
void setup() {
  Serial.begin(115200);
  delay(100);
  Serial.println("\nMIMO starting...");
  randomSeed(esp_random());

  pinMode(PIN_TOUCH, INPUT_PULLDOWN);

  // OLED: scan both common I2C addresses before initialising.
  Wire.begin(PIN_SDA, PIN_SCL);
  Wire.setClock(100000); // conservative clock for reliable wiring on a small prototype
  initDisplay();
  lastDisplayInit = millis();

  // Servo: allocate timers, centre briefly, then detach (prevents jitter)
  ESP32PWM::allocateTimer(0);
  ESP32PWM::allocateTimer(1);
  ESP32PWM::allocateTimer(2);
  ESP32PWM::allocateTimer(3);
  attachServo();
  servo.write(90);
  servoDetachAt = millis() + 700;

  // Wi-Fi (non-blocking) + NTP (Asia/Kolkata, UTC+5:30)
  WiFi.persistent(false);
  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  lastWifiAttempt = millis();
  configTzTime("IST-5:30", "pool.ntp.org", "time.google.com", "time.nist.gov");

  // Weather runs in a background task so HTTPS never freezes the animations.
  // 16 KB stack: HTTPS/TLS needs more than the previous 10 KB.
  xTaskCreatePinnedToCore(weatherTask, "weather", 16384, nullptr, 1, nullptr, 0);

  // Startup screen
  drawStartup();
  startupAt = millis();
  nextBlinkAt = millis() + BLINK_PERIOD_MS;
  mode = MODE_STARTUP;
}

// =====================================================================
//                                LOOP
// =====================================================================
void loop() {
  uint32_t now = millis();

  wifiService(now);
  servoService(now);
  displayService(now);

  TouchEvent ev = readTouch();
  if (ev != TOUCH_NONE) handleTouch(ev, millis());

  // readTouch()/setPet() stamp lastActivity/stateSince with a NEWER millis() than the
  // `now` captured at the top of loop(). Without refreshing, (now - lastActivity) wraps
  // to a huge unsigned number and the pet instantly jumps to SAD (or ends HAPPY at once).
  now = millis();

  switch (mode) {
    case MODE_STARTUP:
      if (now - startupAt >= STARTUP_MS) enterPet();
      break;
    case MODE_PET:
      updatePet(now);
      updateBlink(now);       // blink timing is independent of drawing, touch, servo and Wi-Fi
      break;
    default:
      break;
  }

  renderFrame(now);
}

// =====================================================================
//                       DISPLAY INIT / FRAME SCHEDULER
// =====================================================================
// Scans 0x3C / 0x3D and starts the SH1106. Safe to call again if the OLED
// was missing at boot (loose wire, slow power-up): nothing here can hang.
bool initDisplay() {
  uint8_t oledAddress = 0;
  const uint8_t candidates[] = {OLED_ADDR, 0x3D};
  for (uint8_t addr : candidates) {
    Wire.beginTransmission(addr);
    if (Wire.endTransmission() == 0) {
      oledAddress = addr;
      break;
    }
  }
  if (oledAddress != 0 && display.begin(oledAddress, true)) {
    displayReady = true;
    display.setTextWrap(false);
    display.setTextColor(C_ON);
    display.clearDisplay();
    display.display();
    Serial.printf("OLED detected at 0x%02X\n", oledAddress);
    return true;
  }
  displayReady = false;
  Serial.println("ERROR: OLED not detected at 0x3C or 0x3D. Check VCC, GND, SDA=21, SCL=22.");
  return false;
}

// If the OLED was not found, keep trying every few seconds without blocking.
void displayService(uint32_t now) {
  if (displayReady) return;
  if ((now - lastDisplayInit) < DISPLAY_RETRY_MS) return;
  lastDisplayInit = now;
  if (initDisplay()) needRedraw = true;
}

// Evaluates the active screen at most every FRAME_CHECK_MS. Each draw function
// only sends data to the OLED when what it shows has actually changed, so the
// panel is not re-flashed 10-30 times a second with identical content.
void renderFrame(uint32_t now) {
  if (!displayReady) return;
  if (!needRedraw && (now - lastFrame) < FRAME_CHECK_MS) return;
  lastFrame = now;
  bool force = needRedraw;
  needRedraw = false;

  switch (mode) {
    case MODE_STARTUP: if (force) drawStartup();       break;
    case MODE_PET:     updateGaze(); drawPet(now, force); break;
    case MODE_MENU:    drawMenu(force);                break;
    case MODE_CLOCK:   drawClock(force);               break;
    case MODE_WEATHER: drawWeather(now, force);        break;
  }
}

// =====================================================================
//                         TOUCH DETECTION
// =====================================================================
// Debounced state machine. Returns at most one event per call:
//  SINGLE : one short tap, confirmed after DOUBLE_TAP_GAP_MS of silence
//  DOUBLE : two short taps in quick succession
//  LONG   : fires once while still holding, at LONG_PRESS_MS.
//           The release afterwards is ignored (no tap is generated).
TouchEvent readTouch() {
  uint32_t now = millis();
  bool raw = (digitalRead(PIN_TOUCH) == HIGH);

  if (raw != ts.lastRaw) { ts.lastRaw = raw; ts.rawChangedAt = now; }

  if ((now - ts.rawChangedAt) >= DEBOUNCE_MS && raw != ts.stable) {
    ts.stable = raw;
    if (ts.stable) {                       // ---- pressed
      ts.pressStart = now;
      ts.longFired = false;
      lastActivity = now;
    } else {                               // ---- released
      lastActivity = now;
      if (!ts.longFired && (now - ts.pressStart) <= MAX_TAP_MS) {
        if (ts.tapCount < 3) ts.tapCount++;
        ts.lastTapRelease = now;
      } else {
        ts.tapCount = 0;                   // long/medium hold: not a tap
      }
    }
  }

  // Long press while still held
  if (ts.stable && !ts.longFired && (now - ts.pressStart) >= LONG_PRESS_MS) {
    ts.longFired = true;
    ts.tapCount = 0;
    Serial.println("Touch: LONG");
    return TOUCH_LONG;
  }

  // Wait for the tap sequence to finish so 1, 2 and 3 taps are distinguished.
  if (!ts.stable && !ts.lastRaw && ts.tapCount >= 3) {
    ts.tapCount = 0;
    Serial.println("Touch: TRIPLE");
    return TOUCH_TRIPLE;
  }

  if (!ts.stable && !ts.lastRaw && ts.tapCount > 0 &&
      (now - ts.lastTapRelease) >= DOUBLE_TAP_GAP_MS) {
    uint8_t completedTaps = ts.tapCount;
    ts.tapCount = 0;
    if (completedTaps == 2) {
      Serial.println("Touch: DOUBLE");
      return TOUCH_DOUBLE;
    }
    Serial.println("Touch: SINGLE");
    return TOUCH_SINGLE;
  }
  return TOUCH_NONE;
}

// =====================================================================
//                         EVENT HANDLING
// =====================================================================
void handleTouch(TouchEvent ev, uint32_t now) {
  lastActivity = now;
  switch (mode) {
    case MODE_STARTUP:
      break;

    case MODE_PET:
      if (ev == TOUCH_LONG) {
        enterMenu();
      } else if (ev == TOUCH_TRIPLE) {
        setPet(PET_ANGRY);                     // angry ONLY comes from 3 quick taps
      } else if (ev == TOUCH_SINGLE) {
        // One tap in NORMAL / SAD / ANGRY -> HAPPY (servo dances), then back to NORMAL.
        if (petState != PET_HAPPY) setPet(PET_HAPPY);
      }
      // Double taps intentionally do nothing in pet mode.
      break;

    case MODE_MENU:
      if (ev == TOUCH_SINGLE) {
        menuIndex = (menuIndex + 1) % 3;
        Serial.printf("Menu: highlight %d\n", menuIndex);
      } else if (ev == TOUCH_DOUBLE) {
        Serial.printf("Menu: select %d\n", menuIndex);
        if (menuIndex == 0)      enterPet();
        else if (menuIndex == 1) mode = MODE_CLOCK;
        else                     mode = MODE_WEATHER;
        needRedraw = true;                               // redraw immediately
      } else if (ev == TOUCH_LONG) {
        enterPet();                                      // back to home screen
      }
      break;

    case MODE_CLOCK:
    case MODE_WEATHER:
      if (ev == TOUCH_LONG || ev == TOUCH_DOUBLE) {      // hold or double tap = menu
        enterMenu();
      }
      break;
  }
}

void enterPet() {
  mode = MODE_PET;
  setPet(PET_NORMAL);
  gazeX = gazeY = gazeTX = gazeTY = 0;
  nextGazeAt = millis() + 1500;
  nextBlinkAt = millis() + BLINK_PERIOD_MS;
  blinking = false;
  lastActivity = millis();
  lastPetKey = 0xFF;
  needRedraw = true;
}

void enterMenu() {
  stopDance();
  menuIndex = 0;
  mode = MODE_MENU;
  needRedraw = true;                                     // redraw immediately
}

// =====================================================================
//                            PET LOGIC
// =====================================================================
void setPet(PetState s) {
  uint32_t now = millis();
  PetState prev = petState;
  petState = s;
  stateSince = now;
  if (s == PET_HAPPY) startDance();
  else if (prev == PET_HAPPY) stopDance();
  if (s == PET_NORMAL) lastActivity = now;   // restart the 20 s sadness timer
}

void updatePet(uint32_t now) {
  // Signed differences: never wrap if a timestamp is a millisecond newer than `now`.
  if (petState == PET_HAPPY && (int32_t)(now - stateSince) >= (int32_t)HAPPY_DURATION_MS) {
    setPet(PET_NORMAL);
  } else if ((petState == PET_NORMAL || petState == PET_ANGRY) &&
             (int32_t)(now - lastActivity) >= (int32_t)SAD_TIMEOUT_MS) {
    setPet(PET_SAD);
  }
}

void updateGaze() {
  uint32_t now = millis();
  if (now >= nextGazeAt) {
    if (random(0, 3) == 0) { gazeTX = 0; gazeTY = 0; }
    else { gazeTX = random(-3, 4); gazeTY = random(-2, 3); }
    nextGazeAt = now + random(1500, 4000);
  }
  gazeX += (gazeTX - gazeX) * 0.22f;     // easing = smooth motion
  gazeY += (gazeTY - gazeY) * 0.22f;
}

// Blink scheduler: a new blink STARTS every BLINK_PERIOD_MS (2 s) and lasts
// BLINK_MS. Runs every loop() pass, so it never depends on how often the
// screen is drawn and never waits on the touch, servo, clock or weather code.
void updateBlink(uint32_t now) {
  if (!blinking) {
    if ((int32_t)(now - nextBlinkAt) >= 0) {
      blinking = true;
      blinkStart = now;
      nextBlinkAt = now + BLINK_PERIOD_MS;
    }
  } else if ((float)(now - blinkStart) >= BLINK_MS) {
    blinking = false;               // the eyes ALWAYS reopen here
  }
}

// Eyelid closure 0.0 (open) .. 1.0 (closed). Pure function: no side effects.
float blinkAmount(uint32_t now) {
  if (!blinking) return 0.0f;
  float t = (float)(now - blinkStart);
  if (t >= BLINK_MS) return 0.0f;
  float half = BLINK_MS / 2.0f;
  return (t < half) ? (t / half) : (1.0f - (t - half) / half);
}

// 0 = open, 1 = half-shut, 2 = fully shut
uint8_t blinkPhase(uint32_t now) {
  float a = blinkAmount(now);
  if (a >= 0.6f) return 2;
  if (a >= 0.2f) return 1;
  return 0;
}

// =====================================================================
//                              SERVO
// =====================================================================
void attachServo() {
  if (!servoAttached) {
    servo.setPeriodHertz(50);
    servo.attach(PIN_SERVO, 500, 2400);
    servoAttached = true;
  }
}

void startDance() {
  attachServo();
  servoDetachAt = 0;
  danceActive = true;
  danceStep = 0;
  danceLastStep = millis();
  servo.write(DANCE_ANGLES[0]);
}

void stopDance() {
  if (danceActive) {
    danceActive = false;
    if (servoAttached) { servo.write(90); servoDetachAt = millis() + 500; }
  }
}

// Non-blocking dance sequencer; detaches the servo afterwards to stop jitter.
void servoService(uint32_t now) {
  if (danceActive && (now - danceLastStep) >= DANCE_STEP_MS) {
    danceLastStep = now;
    danceStep++;
    if (danceStep >= DANCE_STEPS) {
      danceActive = false;
      servo.write(90);
      servoDetachAt = now + 500;
    } else {
      servo.write(DANCE_ANGLES[danceStep]);
    }
  }
  if (!danceActive && servoAttached && servoDetachAt != 0 && (int32_t)(now - servoDetachAt) >= 0) {
    servo.detach();
    servoAttached = false;
    servoDetachAt = 0;
  }
}

// =====================================================================
//                           WI-FI / WEATHER
// =====================================================================
void wifiService(uint32_t now) {
  if (WiFi.status() == WL_CONNECTED) return;
  if ((now - lastWifiAttempt) >= WIFI_RETRY_MS) {
    lastWifiAttempt = now;
    Serial.println("Wi-Fi: (re)connecting...");
    WiFi.disconnect();
    WiFi.begin(WIFI_SSID, WIFI_PASS);
  }
}

bool fetchWeather() {
  WiFiClientSecure client;
  client.setInsecure();                      // no certificate pinning (simple, fine for weather)
  HTTPClient http;
  http.setTimeout(8000);
  if (!http.begin(client, WEATHER_URL)) return false;

  int code = http.GET();
  if (code != HTTP_CODE_OK) {
    Serial.printf("Weather HTTP error: %d\n", code);
    http.end();
    return false;
  }
  String body = http.getString();
  http.end();

#if ARDUINOJSON_VERSION_MAJOR >= 7
  JsonDocument doc;                           // ArduinoJson 7
#else
  DynamicJsonDocument doc(1024);              // ArduinoJson 6
#endif
  DeserializationError err = deserializeJson(doc, body);
  if (err) { Serial.println("Weather JSON error"); return false; }

  JsonObject cur = doc["current"].as<JsonObject>();
  if (cur.isNull() || cur["temperature_2m"].isNull() || cur["relative_humidity_2m"].isNull()) {
    return false;
  }

  WeatherData w;
  w.valid = true;
  w.tempC = cur["temperature_2m"].as<float>();
  w.humidity = cur["relative_humidity_2m"].as<int>();
  w.code = cur["weather_code"] | 0;
  w.updatedAt = millis();

  portENTER_CRITICAL(&weatherMux);
  weather = w;
  portEXIT_CRITICAL(&weatherMux);
  Serial.printf("Weather: %.1fC  %d%%  code %d\n", w.tempC, w.humidity, w.code);
  return true;
}

void weatherTask(void* param) {
  uint32_t lastAttempt = 0;
  bool first = true;
  bool lastOk = false;
  for (;;) {
    if (WiFi.status() == WL_CONNECTED) {
      uint32_t now = millis();
      uint32_t interval = lastOk ? WEATHER_REFRESH_MS : WEATHER_RETRY_MS;
      if (first || (now - lastAttempt) >= interval) {
        first = false;
        lastAttempt = now;
        weatherFetching = true;
        lastOk = fetchWeather();
        weatherLastFailed = !lastOk;
        weatherFetching = false;
      }
    }
    vTaskDelay(pdMS_TO_TICKS(500));
  }
}

// WMO weather code -> short text (max 10 chars so it fits at text size 2)
const char* weatherText(int c) {
  switch (c) {
    case 0:  return "Clear";
    case 1:  return "Mostly clr";
    case 2:  return "Partly cld";
    case 3:  return "Overcast";
    case 45: case 48: return "Fog";
    case 51: case 53: case 55: case 56: case 57: return "Drizzle";
    case 61: case 63: case 65: case 66: case 67: return "Rain";
    case 71: case 73: case 75: case 77: return "Snow";
    case 80: case 81: case 82: return "Showers";
    case 85: case 86: return "Snow shwr";
    case 95: return "T-storm";
    case 96: case 99: return "Storm+hail";
    default: return "Unknown";
  }
}

// =====================================================================
//                              DRAWING
// =====================================================================
// Default GFX font: each character cell is 6*size wide and 8*size tall, but
// the last column/row of the cell is blank, so the real ink is 6*size-size wide.
// Text is centred on the ink width and clamped so it can never leave the screen.
void drawCentered(const char* s, int y, uint8_t size) {
  if (!displayReady) return;
  int len = (int)strlen(s);
  int w = (len > 0) ? (len * 6 * size - size) : 0;
  int x = (SCREEN_W - w) / 2;
  if (x < 0) x = 0;
  display.setTextSize(size);
  display.setCursor(x, y);
  display.print(s);
}

// Two size-2 lines for status messages (each line <= 10 characters).
void drawTwoLines(const char* l1, const char* l2) {
  display.setTextColor(C_ON);
  drawCentered(l1, 12, 2);
  drawCentered(l2, 36, 2);
}

void drawStartup() {
  if (!displayReady) return;
  display.clearDisplay();
  display.setTextColor(C_ON);
  drawCentered("Hey,", 13, 2);
  drawCentered("I am Mimo!", 37, 2);
  display.display();
}

// Repaints Mimo's face only when the expression or the blink phase changed.
void drawPet(uint32_t now, bool force) {
  if (!displayReady) return;

  uint8_t phase = blinkPhase(now);                         // 0 open, 1 half-shut, 2 shut
  if (petState == PET_HAPPY && !BLINK_WHEN_HAPPY) phase = 0;

  uint8_t key = (uint8_t)petState * 3 + phase;
  if (!force && key == lastPetKey) return;
  lastPetKey = key;

  switch (petState) {
    case PET_SAD:
      drawSadEyes(phase != 0);
      break;
    case PET_HAPPY:
      if (phase == 2) drawBlinkEyes(); else drawHappyEyes();
      break;
    case PET_ANGRY:
      if (phase == 2) drawBlinkEyes(); else drawAngryEyes();
      break;
    default: // PET_NORMAL
      if (phase == 2)      drawBlinkEyes();
      else if (phase == 1) drawHalfLidEyes();
      else                 drawEyes(false);
      break;
  }
}

